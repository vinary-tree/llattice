@startuml lattice-class
' Layered llattice v2 traits, lawful built-ins, and consumer-side concurrency.
' Render: plantuml -tsvg lattice-class.puml

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowColor #475569
skinparam roundcorner 7
skinparam interface {
  BackgroundColor #C4B5FD
  BorderColor #5B21B6
  FontColor #1E1B4B
}
skinparam class {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
  FontColor #111827
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #B45309
}

interface "JoinSemilattice" as Join <<trait>> {
  Clone + PartialEq
  --
  + join_assign(other: &Self): bool
  + join(other: &Self): Self
  + leq(other: &Self): bool
}

interface "MeetSemilattice" as Meet <<trait>> {
  Clone + PartialEq
  --
  + meet(other: &Self): Self
}

interface "Lattice" as Lattice <<marker>>
interface "Bottom" as Bottom <<trait>> {
  + bottom(): Self
}

Join <|-- Lattice
Meet <|-- Lattice
Join <|-- Bottom

class "Integers" as Integers #86EFAC {
  join = max
  meet = min
  bottom = MIN
}
class "bool" as Bool #86EFAC {
  join = OR
  meet = AND
  bottom = false
}
class "Option<T>" as OptionT #BFDBFE {
  capability-preserving lift
  bottom = None
}
class "HashSet<T, S>" as HashSetT #BFDBFE {
  join = union
  meet = intersection
  bottom when S: Default
}

Integers ..|> Lattice : lawful
Integers ..|> Bottom
Bool ..|> Lattice : lawful
Bool ..|> Bottom
OptionT ..|> Lattice : when T: Lattice
OptionT ..|> Bottom : when T: Join
HashSetT ..|> Lattice : lawful
HashSetT ..|> Bottom : when S: Default

class "Parallel consumer" as Parallel #FCD34D {
  adds Send + Sync
  at scheduling boundary
}
Parallel ..> Join : constrains T

note right of Lattice
  explicit marker:
  both absorption laws required
end note

note bottom of HashSetT
  iterative heap-backed work;
  native-stack depth is independent of input size
end note

@enduml
