// The defining geometry of a lattice: every pair {a, b} has a least upper bound a ⊔ b (the join,
// drawn ABOVE both) and a greatest lower bound a ⊓ b (the meet, drawn BELOW both).
// Mnemonic colours: join = green (climb up), meet = amber (descend), operands = violet.
// Render:  dot -Tsvg lub-glb-geometry.dot -o lub-glb-geometry.svg   Tool: Graphviz (graph_layout).
digraph lub_glb {
    bgcolor = "white";
    rankdir = BT;
    ranksep = 0.5;
    node [shape=box, style="rounded,filled", fontname="DejaVu Sans",
          fontsize=12, color="#374151", penwidth=1.1];
    edge [dir=none, color="#6B7280", penwidth=1.1];

    top  [label="⊤", fillcolor="#93C5FD"];
    join [label="a ⊔ b\nleast upper bound (supremum)", fillcolor="#86EFAC", color="#16A34A"];
    a    [label="a", fillcolor="#C4B5FD"];
    b    [label="b", fillcolor="#C4B5FD"];
    meet [label="a ⊓ b\ngreatest lower bound (infimum)", fillcolor="#FCD34D", color="#B45309"];
    bot  [label="⊥", fillcolor="#E5E7EB"];

    bot -> meet;
    meet -> a; meet -> b;
    a -> join; b -> join;
    join -> top;

    { rank=same; a; b; }
}
