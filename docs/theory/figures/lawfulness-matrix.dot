digraph lawfulness {
    // llattice v2 lawfulness matrix: green lawful, amber conditional, red excluded.
    bgcolor = "white";
    node [shape=plaintext, fontname="DejaVu Sans"];

    M [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="7">
      <tr>
        <td bgcolor="#1F2937"><font color="white"><b>domain</b></font></td>
        <td bgcolor="#1F2937"><font color="white"><b>join</b></font></td>
        <td bgcolor="#1F2937"><font color="white"><b>meet</b></font></td>
        <td bgcolor="#1F2937"><font color="white"><b>absorption</b></font></td>
        <td bgcolor="#1F2937"><font color="white"><b>bottom</b></font></td>
        <td bgcolor="#1F2937"><font color="white"><b>v2 exposure</b></font></td>
      </tr>
      <tr>
        <td align="left"><b>integer primitives</b></td>
        <td bgcolor="#86EFAC">lawful</td><td bgcolor="#86EFAC">lawful</td>
        <td bgcolor="#86EFAC">lawful</td><td bgcolor="#86EFAC">MIN</td>
        <td bgcolor="#86EFAC">all traits</td>
      </tr>
      <tr>
        <td align="left"><b>bool</b></td>
        <td bgcolor="#86EFAC">OR</td><td bgcolor="#86EFAC">AND</td>
        <td bgcolor="#86EFAC">lawful</td><td bgcolor="#86EFAC">false</td>
        <td bgcolor="#86EFAC">all traits</td>
      </tr>
      <tr>
        <td align="left"><b>Option&lt;T&gt;</b></td>
        <td bgcolor="#FCD34D">inherits T</td><td bgcolor="#FCD34D">inherits T</td>
        <td bgcolor="#FCD34D">when T: Lattice</td><td bgcolor="#86EFAC">None</td>
        <td bgcolor="#FCD34D">capability preserving</td>
      </tr>
      <tr>
        <td align="left"><b>HashSet&lt;T,S&gt;</b></td>
        <td bgcolor="#86EFAC">union</td><td bgcolor="#86EFAC">intersection</td>
        <td bgcolor="#86EFAC">lawful</td><td bgcolor="#FCD34D">when S: Default</td>
        <td bgcolor="#86EFAC">layered traits</td>
      </tr>
      <tr>
        <td align="left"><b>raw f32 / f64</b></td>
        <td bgcolor="#FCA5A5">NaN breaks equality</td>
        <td bgcolor="#FCA5A5">NaN incomparable</td>
        <td bgcolor="#FCA5A5">not applicable</td><td bgcolor="#FCA5A5">none</td>
        <td bgcolor="#FCA5A5">no impl</td>
      </tr>
      <tr>
        <td align="left"><b>raw Vec&lt;T&gt;</b></td>
        <td bgcolor="#FCA5A5">left bias</td><td bgcolor="#FCA5A5">left bias</td>
        <td bgcolor="#FCA5A5">fails structurally</td><td bgcolor="#FCA5A5">none</td>
        <td bgcolor="#FCA5A5">no impl</td>
      </tr>
      <tr>
        <td colspan="6" align="left"><font point-size="10">
        Trait laws use Rust structural PartialEq. Validated or canonicalized
        newtypes may expose narrower carriers lawfully.
        </font></td>
      </tr>
    </table>
    >];
}
