# The unifying isomorphism 𝒫(U) ≅ 2^U: a subset of U is the same datum as a U-indexed tuple of bits,
# which is the same as a function U → 2. This ties together the built-in bool
# and HashSet domains with external version-vector/bitset product domains.
# Render:  d2 powerset-iso.d2 powerset-iso.svg     Tool: D2 (uml_architecture, mapping diagram).
direction: right

two:  "2  =  bool\n{ false ⊑ true }\n(the two-element Boolean lattice)" {
  style: { fill: "#DBEAFE"; stroke: "#1E3A8A" }
}
prod: "2^U  =  U-indexed tuple of bits\n(version vector / canonical bitset domain)" {
  style: { fill: "#BFDBFE"; stroke: "#1E3A8A" }
}
pset: "𝒫(U)  =  HashSet<T>\n(subsets of U ordered by ⊆)" {
  style: { fill: "#93C5FD"; stroke: "#1E3A8A" }
}

two -> prod:  "product over U (one factor 2 per element)" { style.stroke: "#16A34A" }
prod -> pset: "≅  characteristic function χ_S : U → 2" { style.stroke: "#16A34A"; style.stroke-width: 2 }
pset -> prod: "≅  membership bits  (u ∈ S)" { style.stroke: "#16A34A"; style.stroke-width: 2 }
