digraph law_audit {
    // Generate (a,b,c), check each law and dual, then accept or shrink a counterexample.
    // This is the property-test pipeline documented in engineering/01-testing.md.
    bgcolor = "white";
    rankdir = TB;
    nodesep = 0.40;
    ranksep = 0.42;
    node [fontname="DejaVu Sans", fontsize=11, color="#374151", penwidth=1.1];
    edge [fontname="DejaVu Sans", fontsize=10, color="#6B7280", fontcolor="#374151"];

    gen   [label="generate (a, b, c)\nproptest / exhaustive", shape=box, style="rounded,filled", fillcolor="#EDE9FE", color="#5B21B6"];
    idem  [label="idempotent?\na ⊔ a = a   (and a ⊓ a = a)", shape=diamond, style="filled", fillcolor="#FEF3C7"];
    comm  [label="commutative?\na ⊔ b = b ⊔ a   (and dual)", shape=diamond, style="filled", fillcolor="#FEF3C7"];
    assoc [label="associative?\n(a ⊔ b) ⊔ c = a ⊔ (b ⊔ c)   (and dual)", shape=diamond, style="filled", fillcolor="#FEF3C7"];
    absb  [label="absorption?\na ⊔ (a ⊓ b) = a   (and dual)", shape=diamond, style="filled", fillcolor="#FEF3C7"];
    pass  [label="lawful ✓\n(accept impl)", shape=box, style="rounded,filled", fillcolor="#86EFAC", color="#16A34A"];
    fail  [label="counterexample ✗\nshrink & report", shape=box, style="rounded,filled", fillcolor="#FCA5A5", color="#B91C1C"];

    gen   -> idem;
    idem  -> comm  [label="holds"];
    comm  -> assoc [label="holds"];
    assoc -> absb  [label="holds"];
    absb  -> pass  [label="all four hold"];

    idem  -> fail [label="fails", color="#B91C1C", fontcolor="#B91C1C"];
    comm  -> fail [label="fails", color="#B91C1C", fontcolor="#B91C1C"];
    assoc -> fail [label="fails", color="#B91C1C", fontcolor="#B91C1C"];
    absb  -> fail [label="fails", color="#B91C1C", fontcolor="#B91C1C"];

    { rank = same; pass; fail; }
}
