digraph nan_poison {
    // Raw floats are excluded because max/min can drop NaN and NaN is incomparable.
    bgcolor = "white";
    rankdir = LR;
    ranksep = 0.6;
    node [shape=box, style="rounded,filled", fontname="DejaVu Sans",
          fontsize=11, color="#374151", penwidth=1.1];
    edge [color="#6B7280", penwidth=1.1, fontname="DejaVu Sans", fontsize=10, fontcolor="#6B7280"];

    subgraph cluster_drop {
        label = "Exclusion 1 — candidate join drops NaN"; fontname="DejaVu Sans"; fontsize=11;
        color="#FCD34D"; style="rounded"; fontcolor="#B45309";
        stream [label="fold ⊔ over [3.0, NaN, 5.0]", fillcolor="#DBEAFE"];
        nan1   [label="NaN", fillcolor="#FCA5A5", color="#B91C1C"];
        res    [label="result = 5.0\n(NaN vanished)", fillcolor="#FCD34D", color="#B45309"];
        nan1 -> stream [label="enters", style=dashed];
        stream -> res [label="max() ignores NaN"];
    }

    subgraph cluster_order {
        label = "Exclusion 2 — NaN breaks the order ⊑"; fontname="DejaVu Sans"; fontsize=11;
        color="#FCA5A5"; style="rounded"; fontcolor="#B91C1C";
        nan2 [label="NaN", fillcolor="#FCA5A5", color="#B91C1C"];
        cmp  [label="NaN ≤ 3.0 ?", fillcolor="#FEE2E2"];
        none [label="None  (incomparable) ✗", fillcolor="#FCA5A5", color="#B91C1C"];
        inv  [label="order invariant broken\n(NaN.join(NaN) ≠ NaN under ==)", fillcolor="#FCA5A5", color="#B91C1C"];
        nan2 -> cmp; cmp -> none [label="partial_cmp"]; none -> inv;
    }
}
