use Test;
use lib $?FILE.IO.absolute.IO.parent.parent.add('lib').Str;
use LLattice;
use Vinary::Tree::Interop;

plan 17;

my @numbers = (1, 2, 3).map({ MaxMin.new(value => $_) });
is @numbers[0].join(@numbers[2]).value, 3, 'numeric join is max';
is @numbers[0].meet(@numbers[2]).value, 1, 'numeric meet is min';
ok validate-laws(@numbers), 'numeric samples satisfy every lattice law';

my $false = BooleanLattice.new(value => False);
my $true = BooleanLattice.new(value => True);
ok $false.join($true).value, 'Boolean join is disjunction';
nok $false.meet($true).value, 'Boolean meet is conjunction';
ok validate-laws([$false, $true]), 'Boolean samples satisfy every lattice law';

my $left = FiniteSetLattice.new(value => set(1, 2));
my $right = FiniteSetLattice.new(value => set(2, 3));
is-deeply $left.join($right).value, set(1, 2, 3), 'set join is union';
is-deeply $left.meet($right).value, set(2), 'set meet is intersection';

sub encode-int(MaxMin:D $item --> Blob:D) {
    Blob.new((^8).map({ ($item.value.Int +> (56 - 8 * $_)) +& 0xff }))
}

sub decode-int(Blob:D $bytes --> MaxMin:D) {
    my Int $number = 0;
    $number = ($number +< 8) +| $_ for $bytes.list;
    MaxMin.new(value => $number)
}

my $small = provider(MaxMin.new(value => 3),
    domain-id => 'll.maxmin.i64.v1', :encode(&encode-int),
    :decode(&decode-int));
my $large = provider(MaxMin.new(value => 8),
    domain-id => 'll.maxmin.i64.v1', :encode(&encode-int),
    :decode(&decode-int));
ok $small.flags +& LATTICE-FLAG-THREAD-BOUND,
    'Raku provider declares its runtime thread boundary';
is value($small).value, 3, 'hosted value remains available idiomatically';
my $joined = $small.join($large);
my $met = $small.meet($large);
is value($joined).value, 8, 'host provider executes join through NativeCall';
is value($met).value, 3, 'host provider executes meet through NativeCall';
ok $joined.equivalent($large), 'host provider equality crosses the ABI';
is-deeply $joined.stable-bytes.list.Array, [0, 0, 0, 0, 0, 0, 0, 8],
    'host provider emits canonical bytes';

my $middle = provider(MaxMin.new(value => 5),
    domain-id => 'll.maxmin.i64.v1', :encode(&encode-int),
    :decode(&decode-int));
my $joined-many = $small.join-many($middle, $large);
my $met-many = $large.meet-many($middle, $small);
is value($joined-many).value, 8, 'batch join stays inside one callback';
is value($met-many).value, 3, 'batch meet stays inside one callback';
for $met-many, $joined-many, $middle, $met, $joined, $large, $small { .close }
nok $small.opened, 'host resources close deterministically';
